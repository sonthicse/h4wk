{
  "$defs": {
    "CommentSettings": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 30,
          "maximum": 50,
          "minimum": 20,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_per_video": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Per Video"
        }
      },
      "title": "CommentSettings",
      "type": "object"
    },
    "FaceSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "FaceSettings",
      "type": "object"
    },
    "JevSettings": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        }
      },
      "title": "JevSettings",
      "type": "object"
    },
    "RefImageSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "RefImageSettings",
      "type": "object"
    },
    "TranscriptKind": {
      "enum": [
        "uploaded",
        "auto",
        "supadata_ai",
        "stt"
      ],
      "title": "TranscriptKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comments": {
      "$ref": "#/$defs/CommentSettings",
      "default": {
        "batch_size": 30,
        "max_per_video": null
      }
    },
    "face": {
      "$ref": "#/$defs/FaceSettings",
      "default": {
        "enabled": true
      }
    },
    "jev": {
      "$ref": "#/$defs/JevSettings",
      "default": {
        "concurrency": 4
      }
    },
    "ref_image": {
      "$ref": "#/$defs/RefImageSettings",
      "default": {
        "enabled": true,
        "threshold": null
      }
    },
    "transcript_priority": {
      "default": [
        "uploaded",
        "stt",
        "auto",
        "supadata_ai"
      ],
      "items": {
        "$ref": "#/$defs/TranscriptKind"
      },
      "title": "Transcript Priority",
      "type": "array"
    }
  },
  "title": "AnalysisConfig",
  "type": "object"
}
