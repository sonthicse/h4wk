{
  "additionalProperties": false,
  "description": "Một quyết định rà soát (một dòng của reviews.jsonl).",
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "by": {
      "pattern": "^(user|system):\\S+$",
      "title": "By",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "finding_key": {
      "title": "Finding Key",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "confirmed",
        "rejected",
        "needs_info"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "finding_key",
    "finding_id",
    "run_id",
    "status",
    "by",
    "at"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
