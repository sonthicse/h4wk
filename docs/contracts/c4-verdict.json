{
  "$defs": {
    "Category": {
      "enum": [
        "insult",
        "unsupported_accusation",
        "fabrication",
        "incitement",
        "state_secret",
        "legitimate_criticism",
        "neutral"
      ],
      "title": "Category",
      "type": "string"
    },
    "Confidence": {
      "description": "Mức tin cậy viết bằng chữ, không dùng phần trăm.",
      "enum": [
        "unverified",
        "likely",
        "highly_likely"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Kết luận theo video (verdict.json), một lần chạy một kết luận.",
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "capture": {
      "pattern": "^\\d{8}T\\d{6}$",
      "title": "Capture",
      "type": "string"
    },
    "categories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Category"
      },
      "title": "Categories",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "finding_ids": {
      "default": [],
      "items": {
        "pattern": "^f_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "violation": {
      "enum": [
        "yes",
        "no",
        "uncertain"
      ],
      "title": "Violation",
      "type": "string"
    }
  },
  "required": [
    "violation",
    "confidence",
    "run_id",
    "video_id",
    "capture",
    "at"
  ],
  "title": "VideoVerdict",
  "type": "object"
}
