      "enum": [
        "video.metadata",
        "channel.metadata",
        "channel.videos",
        "playlist.videos",
        "video.transcripts",
        "video.comments",
        "video.thumbnails",
        "video.media"
      ],
      "title": "Cap",
      "type": "string"
    },
    "Channel": {
