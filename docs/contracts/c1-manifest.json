{
  "$defs": {
    "Cap": {
      "description": "Loại dữ liệu một nguồn thu lấy được. Giá trị dùng trong trường `what` của manifest.",
      "enum": [
        "video.metadata",
        "channel.metadata",
        "channel.videos",
        "playlist.videos",
        "video.transcripts",
        "video.comments",
        "video.thumbnails",
        "video.media"
      ],
      "title": "Cap",
      "type": "string"
    },
    "CollectLevel": {
      "description": "Mức thu (SPEC 10.7).",
      "enum": [
        "metadata",
        "text",
        "full"
      ],
      "title": "CollectLevel",
      "type": "string"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credits"
        },
        "quota_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quota Units"
        }
      },
      "title": "Cost",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "SourceCall": {
      "additionalProperties": false,
      "description": "Một lần gọi (hoặc bỏ qua) một nguồn cho một loại dữ liệu.",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cost"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/SourceStatus"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "what": {
          "$ref": "#/$defs/Cap"
        }
      },
      "required": [
        "provider",
        "what",
        "status"
      ],
      "title": "SourceCall",
      "type": "object"
    },
    "SourceStatus": {
      "enum": [
        "ok",
        "failed",
        "blocked",
        "quota_exceeded",
        "not_found",
        "unsupported",
        "disabled",
        "suspended",
        "no_source"
      ],
      "title": "SourceStatus",
      "type": "string"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "type": {
          "enum": [
            "manual",
            "watchlist"
          ],
          "title": "Type",
          "type": "string"
        },
        "watch_item": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watch Item"
        }
      },
      "required": [
        "type"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collected_at_utc": {
      "format": "date-time",
      "title": "Collected At Utc",
      "type": "string"
    },
    "collector": {
      "pattern": "^(user|system):\\S+$",
      "title": "Collector",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/FileEntry"
      },
      "title": "Files",
      "type": "object"
    },
    "level": {
      "$ref": "#/$defs/CollectLevel"
    },
    "previous_capture": {
      "anyOf": [
        {
          "pattern": "^\\d{8}T\\d{6}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Capture"
    },
    "schema": {
      "const": "h4wk.manifest/1",
      "title": "Schema",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceCall"
      },
      "title": "Sources",
      "type": "array"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/Trigger"
    }
  },
  "required": [
    "schema",
    "source_url",
    "collected_at_utc",
    "collector",
    "trigger",
    "level",
    "tool_version",
    "sources",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
