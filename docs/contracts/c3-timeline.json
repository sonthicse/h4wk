{
  "$defs": {
    "Frame": {
      "additionalProperties": false,
      "description": "Keyframe thuộc một đoạn; ảnh gửi thẳng cho Jev, không có mô tả.",
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "t"
      ],
      "title": "Frame",
      "type": "object"
    },
    "FrameOcr": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "bbox",
        "frame",
        "t"
      ],
      "title": "FrameOcr",
      "type": "object"
    },
    "OcrText": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "bbox"
      ],
      "title": "OcrText",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "frames": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        },
        "id": {
          "pattern": "^seg_\\d{4,}$",
          "title": "Id",
          "type": "string"
        },
        "ocr": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FrameOcr"
          },
          "title": "Ocr",
          "type": "array"
        },
        "speech": {
          "default": "",
          "title": "Speech",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "Segment",
      "type": "object"
    },
    "ThumbnailAnalysis": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "ocr": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OcrText"
          },
          "title": "Ocr",
          "type": "array"
        }
      },
      "required": [
        "file"
      ],
      "title": "ThumbnailAnalysis",
      "type": "object"
    },
    "TranscriptKind": {
      "enum": [
        "uploaded",
        "auto",
        "supadata_ai",
        "stt"
      ],
      "title": "TranscriptKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture": {
      "pattern": "^\\d{8}T\\d{6}$",
      "title": "Capture",
      "type": "string"
    },
    "schema": {
      "const": "h4wk.timeline/1",
      "title": "Schema",
      "type": "string"
    },
    "segments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_video_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Video Sha256"
    },
    "thumbnails": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ThumbnailAnalysis"
      },
      "title": "Thumbnails",
      "type": "array"
    },
    "transcript_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "video_id",
    "capture"
  ],
  "title": "Timeline",
  "type": "object"
}
