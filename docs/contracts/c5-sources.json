{
  "$defs": {
    "Cap": {
      "description": "Loại dữ liệu một nguồn thu lấy được. Giá trị dùng trong trường `what` của manifest.",
      "enum": [
        "video.metadata",
        "channel.metadata",
        "channel.videos",
        "playlist.videos",
        "video.transcripts",
        "video.comments",
        "video.thumbnails",
        "video.media"
      ],
      "title": "Cap",
      "type": "string"
    },
    "CollectSettings": {
      "additionalProperties": false,
      "properties": {
        "playlist_max_videos": {
          "default": 50,
          "minimum": 1,
          "title": "Playlist Max Videos",
          "type": "integer"
        }
      },
      "title": "CollectSettings",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "fault_injection": {
          "default": false,
          "title": "Fault Injection",
          "type": "boolean"
        }
      },
      "title": "SourceConfig",
      "type": "object"
    },
    "SourceName": {
      "enum": [
        "ytdlp",
        "youtube_api",
        "supadata"
      ],
      "title": "SourceName",
      "type": "string"
    },
    "SourcesSection": {
      "additionalProperties": false,
      "properties": {
        "supadata": {
          "$ref": "#/$defs/SourceConfig",
          "default": {
            "enabled": true,
            "fault_injection": false
          }
        },
        "youtube_api": {
          "$ref": "#/$defs/SourceConfig",
          "default": {
            "enabled": true,
            "fault_injection": false
          }
        },
        "ytdlp": {
          "$ref": "#/$defs/YtDlpConfig",
          "default": {
            "cookies_file": null,
            "enabled": true,
            "fault_injection": false
          }
        }
      },
      "title": "SourcesSection",
      "type": "object"
    },
    "WatchlistSettings": {
      "additionalProperties": false,
      "properties": {
        "check_interval_min": {
          "default": 2,
          "minimum": 1,
          "title": "Check Interval Min",
          "type": "integer"
        },
        "initial_videos": {
          "default": 10,
          "minimum": 0,
          "title": "Initial Videos",
          "type": "integer"
        }
      },
      "title": "WatchlistSettings",
      "type": "object"
    },
    "YtDlpConfig": {
      "additionalProperties": false,
      "properties": {
        "cookies_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cookies File"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "fault_injection": {
          "default": false,
          "title": "Fault Injection",
          "type": "boolean"
        }
      },
      "title": "YtDlpConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collect": {
      "$ref": "#/$defs/CollectSettings",
      "default": {
        "playlist_max_videos": 50
      }
    },
    "priority": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/SourceName"
        },
        "type": "array"
      },
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/Cap"
      },
      "title": "Priority",
      "type": "object"
    },
    "sources": {
      "$ref": "#/$defs/SourcesSection",
      "default": {
        "supadata": {
          "enabled": true,
          "fault_injection": false
        },
        "youtube_api": {
          "enabled": true,
          "fault_injection": false
        },
        "ytdlp": {
          "cookies_file": null,
          "enabled": true,
          "fault_injection": false
        }
      }
    },
    "watchlist": {
      "$ref": "#/$defs/WatchlistSettings",
      "default": {
        "check_interval_min": 2,
        "initial_videos": 10
      }
    }
  },
  "title": "SourcesConfig",
  "type": "object"
}
