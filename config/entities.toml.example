# Đối tượng cần bảo vệ. Mỗi đối tượng một bảng [[entities]]; có thể sửa tay hoặc ở trang Entities.
# Ảnh mẫu (khuôn mặt, ảnh) tải lên ở trang Entities và nằm trong data/entities/<id>/refs/.
# Khi trang Entities ghi lại file này, các comment sẽ mất.
#
# [[entities]]
# id = "e_01"                          # e_ và ít nhất 2 chữ số, không trùng
# name = "Nguyễn Văn A"
# aliases = ["Ông A", "Anh A"]         # biệt danh, cách gọi khác
# abbreviations = ["NVA"]              # viết tắt, khớp đúng hoa thường
# description = "Ca sĩ"                # mô tả ngắn giúp Jev nhận ra đối tượng (không bắt buộc)
