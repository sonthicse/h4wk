# Cấu hình phân tích (hợp đồng C5).

# Thứ tự chọn transcript chính để ghép timeline và phân tích.
transcript_priority = ["uploaded", "stt", "auto", "supadata_ai"]

[face]
enabled = true                 # khớp khuôn mặt với ảnh mẫu của đối tượng trong case

[ref_image]
enabled = true
# threshold = 0.85             # độ tương đồng tối thiểu (0–1); bỏ trống thì dùng mặc định chốt ở T40

[comments]
batch_size = 30                # số comment mỗi lô gửi LLM (20–50)
# max_per_video = 500          # bỏ trống thì không giới hạn

[keyframes]
phash_threshold = 6   # số bit khác nhau trong pHash 64 bit
tile_threshold = 2.0  # độ lệch tuyệt đối trung bình theo kênh màu, mỗi ô 0–255
