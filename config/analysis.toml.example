# Cấu hình phân tích (quy ước C5).

# Thứ tự chọn transcript chính để ghép timeline và phân tích.
transcript_priority = ["uploaded", "stt", "auto", "supadata_ai"]

[face]
enabled = true                 # khớp khuôn mặt với ảnh mẫu của đối tượng trong case

[ref_image]
enabled = true
# threshold = 0.85             # độ tương đồng tối thiểu (0–1); bỏ trống thì dùng mặc định chốt ở T40

[comments]
# max_per_video = 500          # giới hạn comment gửi Jev; bỏ trống thì không giới hạn

[jev]
concurrency = 4               # số yêu cầu Jev song song (1–16)
