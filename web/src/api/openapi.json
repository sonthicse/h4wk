  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "insult",
          "unsupported_accusation",
          "fabrication",
          "incitement",
          "state_secret",
          "legitimate_criticism",
          "neutral"
        ],
        "title": "Category"
      },
      "CollectBody": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "level": {
            "$ref": "#/components/schemas/CollectLevel",
            "default": "full"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CollectBody"
      },
      "CollectLevel": {
        "type": "string",
        "enum": [
          "metadata",
          "text",
          "full"
        ],
        "title": "CollectLevel",
        "description": "M\u1ee9c thu (SPEC 10.7)."
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "unverified",
          "likely",
          "highly_likely"
        ],
        "title": "Confidence",
        "description": "M\u1ee9c tin c\u1eady vi\u1ebft b\u1eb1ng ch\u1eef, kh\u00f4ng d\u00f9ng ph\u1ea7n tr\u0103m."
      },
      "Entity": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e_\\d{2,}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Entity",
        "description": "\u0110\u1ed1i t\u01b0\u1ee3ng c\u1ea7n b\u1ea3o v\u1ec7. \u1ea2nh m\u1eabu n\u1eb1m \u1edf entities/<id>/refs/{face,image}/."
      },
      "EntityCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "EntityCreate"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f_[0-9A-HJKMNP-TV-Z]{26}$",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "capture": {
            "type": "string",
            "pattern": "^\\d{8}T\\d{6}$",
            "title": "Capture"
          },
          "analyzer": {
            "type": "string",
            "enum": [
              "static",
              "llm"
            ],
            "title": "Analyzer"
          },
          "analyzer_version": {
            "type": "string",
            "title": "Analyzer Version"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "triggers": {
            "items": {
              "$ref": "#/components/schemas/Trigger"
            },
            "type": "array",
            "title": "Triggers",
            "default": []
          },
          "segment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Id"
          },
          "comment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment Id"
          },
          "start": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "default": ""
          },
          "frame": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frame"
          },
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "entity": {
            "type": "string",
            "title": "Entity"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "run_id",
          "video_id",
          "capture",
          "analyzer",
          "analyzer_version",
          "source_kind",
          "entity",
          "category",
          "severity",
          "confidence",
          "reason"
        ],
        "title": "Finding",
        "description": "M\u1ed9t nghi v\u1ea5n (m\u1ed9t ph\u1ea7n t\u1eed c\u1ee7a findings.json)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "capture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "target",
          "video_id",
          "level",
          "trigger",
          "status",
          "step",
          "progress",
          "capture",
          "run_id",
          "error",
          "created_at",
          "updated_at"
        ],
        "title": "Job"
      },
      "LoginBody": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginBody"
      },
      "Me": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "Me"
      },
      "ModelRef": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelRef"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Severity"
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "speech",
          "ocr",
          "visual",
          "title",
          "description",
          "thumbnail",
          "comment"
        ],
        "title": "SourceKind"
      },
      "Trigger": {
        "properties": {
          "via": {
            "$ref": "#/components/schemas/Via"
          },
          "segment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Id"
          },
          "comment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment Id"
          },
          "frame": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frame"
          },
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "via"
        ],
        "title": "Trigger",
        "description": "D\u1ea5u hi\u1ec7u \u0111\u00e3 k\u00e9o m\u1ed9t \u0111o\u1ea1n v\u00e0o ph\u00e2n t\u00edch."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Via": {
        "type": "string",
        "enum": [
          "speech",
          "ocr",
          "title",
          "description",
          "comment",
          "thumbnail",
          "face",
          "ref_image"
        ],
        "title": "Via"
      }
    }
  }
}
