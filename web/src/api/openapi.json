  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "insult",
          "unsupported_accusation",
          "fabrication",
          "incitement",
          "state_secret",
          "legitimate_criticism",
          "neutral"
        ],
        "title": "Category"
      },
      "CollectBody": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "level": {
            "$ref": "#/components/schemas/CollectLevel",
            "default": "full"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CollectBody"
      },
      "CollectLevel": {
        "type": "string",
        "enum": [
          "metadata",
          "text",
          "full"
        ],
        "title": "CollectLevel",
        "description": "M\u1ee9c thu (SPEC 10.7)."
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "unverified",
          "likely",
          "highly_likely"
        ],
        "title": "Confidence",
        "description": "M\u1ee9c tin c\u1eady vi\u1ebft b\u1eb1ng ch\u1eef, kh\u00f4ng d\u00f9ng ph\u1ea7n tr\u0103m."
      },
      "DecisionBody": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "needs_info"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DecisionBody"
      },
      "Entity": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e_\\d{2,}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Entity",
        "description": "\u0110\u1ed1i t\u01b0\u1ee3ng c\u1ea7n b\u1ea3o v\u1ec7. \u1ea2nh m\u1eabu n\u1eb1m \u1edf entities/<id>/refs/{face,image}/."
      },
      "EntityCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "EntityCreate"
      },
      "EntityOut": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e_\\d{2,}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          },
          "ref_counts": {
            "$ref": "#/components/schemas/RefCounts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "ref_counts"
        ],
        "title": "EntityOut"
      },
      "EntityUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "aliases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aliases"
          },
          "abbreviations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abbreviations"
          }
        },
        "type": "object",
        "title": "EntityUpdate"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^f_[0-9A-HJKMNP-TV-Z]{26}$",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "capture": {
            "type": "string",
            "pattern": "^\\d{8}T\\d{6}$",
            "title": "Capture"
          },
          "analyzer": {
            "type": "string",
            "enum": [
              "static",
              "llm"
            ],
            "title": "Analyzer"
          },
          "analyzer_version": {
            "type": "string",
            "title": "Analyzer Version"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "triggers": {
            "items": {
              "$ref": "#/components/schemas/Trigger"
            },
            "type": "array",
            "title": "Triggers",
            "default": []
          },
          "segment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Id"
