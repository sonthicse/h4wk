  "components": {
    "schemas": {
      "CaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "goal": {
            "type": "string",
            "title": "Goal",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CaseCreate"
      },
      "CaseFile": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}_case-\\d{4,}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "goal": {
            "type": "string",
            "title": "Goal",
            "default": ""
          },
          "owner": {
            "type": "string",
            "pattern": "^(user|system):\\S+$",
            "title": "Owner"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "type": "array",
            "title": "Entities",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "owner",
          "created_at"
        ],
        "title": "CaseFile",
        "description": "N\u1ed9i dung case.json."
      },
      "CaseSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "CaseSummary"
      },
      "Entity": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e_\\d{2,}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Entity",
        "description": "\u0110\u1ed1i t\u01b0\u1ee3ng c\u1ea7n b\u1ea3o v\u1ec7. \u1ea2nh m\u1eabu n\u1eb1m \u1edf entities/<id>/refs/{face,image}/."
      },
      "EntityCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "default": []
          },
          "abbreviations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abbreviations",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "EntityCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginBody": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginBody"
      },
      "Me": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "Me"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
